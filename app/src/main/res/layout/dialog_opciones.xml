<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:padding="16dp">
    <TextView
        android:id="@+id/txtopciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opciones"
        android:textSize="25dp"
        android:textStyle="bold"
        android:textColor="#28343A"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp">
    </TextView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnvisto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtopciones"
        android:text="Marcar como visto"
        android:textSize="20dp"
        android:backgroundTint="#318979">
    </com.google.android.material.button.MaterialButton>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnfavorito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnvisto"
        android:layout_marginTop="16dp"
        android:textSize="20dp"
        android:text="Narcar como favorito"
        android:backgroundTint="#DC7907">
    </com.google.android.material.button.MaterialButton>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnreseña"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnfavorito"
        android:layout_marginTop="16dp"
        android:textSize="20dp"
        android:text="Ver reseñas"
        android:backgroundTint="#4D45E2">

    </com.google.android.material.button.MaterialButton>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btncancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnreseña"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D91616"
        android:textSize="20dp"
        android:text="Cancelar">

    </com.google.android.material.button.MaterialButton>



"


</RelativeLayout>